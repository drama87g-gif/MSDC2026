# Environment configuration for desktop applications

# API Configuration
API_BASE_URL=http://localhost:5000
API_TIMEOUT=30

# Application Environment
ENVIRONMENT=development
# ENVIRONMENT=production

# Database Cache (for offline mode)
CACHE_DB=app_cache.db

# Printer Configuration
PRINTER_NAME=default
ENABLE_PRINTER=true

# Barcode Scanner
ENABLE_BARCODE_SCANNER=true

# Features
OFFLINE_MODE=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log
